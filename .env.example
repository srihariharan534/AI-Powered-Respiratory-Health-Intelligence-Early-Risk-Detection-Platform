# ==============================================================================
# NEXUS Environment Configuration Template (Phase 03)
# Copy to .env and adjust values for your local environment.
# NEVER commit .env with real credentials to source control.
# ==============================================================================

# Core Application Settings
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# API Host & Port Settings
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL + PostGIS Spatial Database Configuration
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_DB=nexus_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://nexus:nexus_dev_password@localhost:5432/nexus_db

# Test Database Configuration
POSTGRES_TEST_DB=nexus_test
TEST_DATABASE_URL=postgresql+psycopg2://nexus:nexus_dev_password@localhost:5432/nexus_test

# Client URLs for Local Development
COMMAND_CENTER_PORT=3000
FIELD_APP_PORT=3001
