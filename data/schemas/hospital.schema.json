{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.platform/schemas/hospital.schema.json",
  "title": "Hospital",
  "description": "Canonical contract for medical facilities and emergency triage centers.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "hospital_id": {
      "type": "string",
      "minLength": 3
    },
    "name": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180.0,
              "maximum": 180.0,
              "description": "Longitude in WGS 84"
            },
            {
              "type": "number",
              "minimum": -90.0,
              "maximum": 90.0,
              "description": "Latitude in WGS 84"
            }
          ]
        }
      },
      "required": ["type", "coordinates"],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["OPERATIONAL", "OVERLOADED", "EVACUATING", "CLOSED"]
    },
    "accessibility": {
      "type": "string",
      "enum": ["ALL_VEHICLES", "EMERGENCY_ONLY", "HIGH_CLEARANCE_ONLY", "IMPASSABLE"]
    },
    "capacity": {
      "type": "integer",
      "minimum": 0
    },
    "available_capacity": {
      "type": "integer",
      "minimum": 0
    },
    "emergency_available": {
      "type": "boolean"
    },
    "icu_available": {
      "type": "integer",
      "minimum": 0
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": ["osm", "health_registry", "manual_entry", "simulator", "synthetic_demo"]
    }
  },
  "required": [
    "schema_version",
    "hospital_id",
    "name",
    "location",
    "status",
    "capacity",
    "available_capacity",
    "last_updated",
    "source"
  ],
  "additionalProperties": false
}
