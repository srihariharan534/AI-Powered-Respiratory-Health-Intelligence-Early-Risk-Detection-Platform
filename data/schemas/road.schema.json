{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.platform/schemas/road.schema.json",
  "title": "Road",
  "description": "Canonical contract for a road segment or bridge in the emergency transport graph.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "road_id": {
      "type": "string",
      "minLength": 3
    },
    "name": {
      "type": "string"
    },
    "road_type": {
      "type": "string",
      "enum": [
        "motorway",
        "trunk",
        "primary",
        "secondary",
        "tertiary",
        "residential",
        "bridge",
        "culvert"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["OPEN", "RESTRICTED", "BLOCKED", "UNKNOWN"]
    },
    "accessibility": {
      "type": "string",
      "enum": ["ALL_VEHICLES", "EMERGENCY_ONLY", "HIGH_CLEARANCE_ONLY", "IMPASSABLE"]
    },
    "geometry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["LineString", "MultiLineString"]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180.0,
                "maximum": 180.0,
                "description": "Longitude in WGS 84"
              },
              {
                "type": "number",
                "minimum": -90.0,
                "maximum": 90.0,
                "description": "Latitude in WGS 84"
              }
            ]
          },
          "minItems": 2
        }
      },
      "required": ["type", "coordinates"],
      "additionalProperties": false
    },
    "speed_limit_kmh": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 150.0
    },
    "capacity_vehicles_per_hour": {
      "type": "integer",
      "minimum": 0
    },
    "flood_depth_cm": {
      "type": "number",
      "minimum": 0.0
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": ["osm", "field_officer", "simulator", "synthetic_demo"]
    }
  },
  "required": [
    "schema_version",
    "road_id",
    "name",
    "road_type",
    "status",
    "accessibility",
    "geometry",
    "last_updated",
    "source"
  ],
  "additionalProperties": false
}
